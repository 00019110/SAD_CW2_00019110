ffffff;" vertex="1" connectable="0" parent="retention_86"><mxGeometry x="-0.82" y="-9" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="retention_88" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="retention_86"><mxGeometry x="0.82" y="-9" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="retention_89" value="" style="fontFamily=Helvetica;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#222222;fontSize=10.5;endArrow=none;exitX=1;exitY=0.68;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="retention_41" target="retention_75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="retention_90" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="retention_89"><mxGeometry x="-0.82" y="-9" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="retention_91" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="retention_89"><mxGeometry x="0.82" y="-9" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="retention_92" value="assignee" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="retention_89"><mxGeometry x="0" y="-9" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="retention_93" value="&lt;b&gt;Single Responsibility.&lt;/b&gt; The lecture's own example is that &lt;i&gt;Student&lt;/i&gt; should not handle attendance or enrolment logic. Here &lt;i&gt;Student&lt;/i&gt; only keeps its absence run; scoring, alerts and follow-up live in &lt;i&gt;RiskService&lt;/i&gt;, rates and acquisition cost in &lt;i&gt;RetentionService&lt;/i&gt;." style="fontFamily=Helvetica;html=1;shape=note;size=12;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#b59b2b;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontColor=#3d3300;" vertex="1" parent="1"><mxGeometry x="930" y="812" width="440" height="92" as="geometry"/></mxCell><mxCell id="retention_94" value="&lt;b&gt;Why FollowUpAction is composition:&lt;/b&gt; an action exists only as the response to one alert, and is closed with it. &lt;b&gt;Why the others are associations:&lt;/b&gt; scores, alerts, circumstances and withdrawals all refer to a &lt;i&gt;Student&lt;/i&gt; who is created in EduTizim and lives independently of this module." style="fontFamily=Helvetica;html=1;shape=note;size=12;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#b59b2b;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontColor=#3d3300;" vertex="1" parent="1"><mxGeometry x="930" y="690" width="440" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>