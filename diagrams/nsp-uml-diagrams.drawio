style="fontFamily=Helvetica;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#222222;fontSize=10.5;endArrow=open;endSize=9;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.403;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch_12" target="arch_81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch_109" value="queries through repositories" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="arch_108"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="arch_110" value="" style="fontFamily=Helvetica;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#222222;fontSize=10.5;endArrow=open;endSize=9;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.14;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch_12" target="arch_90"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1284" y="425"/><mxPoint x="1284" y="820"/></Array></mxGeometry></mxCell><mxCell id="arch_111" value="SyncService uses the gateway" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="arch_110"><mxGeometry x="-0.62" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="arch_112" value="" style="fontFamily=Helvetica;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#222222;fontSize=10.5;endArrow=open;endSize=9;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.153;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch_81" target="arch_39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch_113" value="maps" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10.5;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="arch_112"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="arch_114" value="&lt;b&gt;Layered architecture&lt;/b&gt; (Lecture 9).&lt;br&gt;Each layer depends only on the layers below it. The presentation layer never touches the database or EduTizim directly.&lt;br&gt;&lt;br&gt;Dashed arrows are dependencies. Class-level arrows inside &lt;i&gt;services&lt;/i&gt; show the main interactions." style="fontFamily=Helvetica;html=1;shape=note;size=12;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#b59b2b;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontColor=#3d3300;" vertex="1" parent="1"><mxGeometry x="1290" y="40" width="250" height="150" as="geometry"/></mxCell><mxCell id="arch_115" value="&lt;b&gt;Two points of change are hidden behind interfaces&lt;/b&gt; (Lecture 10, Dependency Inversion):&lt;br&gt;• &lt;i&gt;AttendanceMethod&lt;/i&gt; – QR today, Face ID later (interview Q7).&lt;br&gt;• &lt;i&gt;EduTizimGateway&lt;/i&gt; – the vendor may offer an API or only export files (NFR-05.3)." style="fontFamily=Helvetica;html=1;shape=note;size=12;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#b59b2b;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontColor=#3d3300;" vertex="1" parent="1"><mxGeometry x="1290" y="210" width="250" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="people" name="B1 People and scheduling"><mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="people_2" value="&lt;b&gt;Class diagram 1 – people and scheduling&lt;/b&gt; &amp;nbsp; &lt;font color='#666666'&gt;packages domain.people and domain.scheduling&lt;/font&gt;" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=