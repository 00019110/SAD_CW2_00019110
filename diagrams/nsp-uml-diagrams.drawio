implements)" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=10.5;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="607" width="176" height="20" as="geometry"/></mxCell><mxCell id="people_98" value="" style="fontFamily=Helvetica;html=1;strokeColor=#222222;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="640" as="sourcePoint"/><mxPoint x="92" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="people_99" value="Composition (part cannot exist alone)" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=10.5;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="176" height="20" as="geometry"/></mxCell><mxCell id="people_100" value="" style="fontFamily=Helvetica;html=1;strokeColor=#222222;startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="663" as="sourcePoint"/><mxPoint x="92" y="663" as="targetPoint"/></mxGeometry></mxCell><mxCell id="people_101" value="Aggregation (has a)" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=10.5;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="653" width="176" height="20" as="geometry"/></mxCell><mxCell id="people_102" value="" style="fontFamily=Helvetica;html=1;strokeColor=#222222;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="686" as="sourcePoint"/><mxPoint x="92" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="people_103" value="Association" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=10.5;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="676" width="176" height="20" as="geometry"/></mxCell><mxCell id="people_104" value="" style="fontFamily=Helvetica;html=1;strokeColor=#222222;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="709" as="sourcePoint"/><mxPoint x="92" y="709" as="targetPoint"/></mxGeometry></mxCell><mxCell id="people_105" value="Dependency (uses / creates)" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=10.5;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="699" width="176" height="20" as="geometry"/></mxCell><mxCell id="people_106" value="&lt;b&gt;Generalization and polymorphism.&lt;/b&gt; &lt;i&gt;User&lt;/i&gt; is abstract; every role overrides &lt;i&gt;permissions()&lt;/i&gt;, so access control (NFR-01.1) needs no if/else on roles. &lt;i&gt;Teacher&lt;/i&gt; is abstract because main and support teachers share check-in, registers and KPI but differ in &lt;i&gt;teaching_groups()&lt;/i&gt; and in whether they record tests.&lt;br&gt;&lt;b&gt;Aggregation, not composition:&lt;/b&gt; a student exists before joining a group and after leaving it." style="fontFamily=Helvetica;html=1;shape=note;size=12;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#b59b2b;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontColor=#3d3300;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="500" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="attendance" name="B2 Attendance"><mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="attendance_2" value="&lt;b&gt;Class diagram 2 – attendance&lt;/b&gt; &amp;nbsp; &lt;font color='#666666'&gt;UC-01 Check In / Out via QR Code and UC-02 Record Student Attendance · grey = detailed in another figure&lt;/font&gt;" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1360" height="22" as="geometry"/></mxCell><mxCell id="attendance_3" value="AttendanceService" style="fontFamily=Helvetica;html=1;swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#222222;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="560" height="162" as="geometry"/></mxCell><mxCell id="attendance_4" value="-clock:Clock" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="attendance_3"><mxGeometry x="0" y="26" width="560" height="23" as="geometry"/></mxCell><mxCell id="attendance_5" value="" style="line;strokeWidth=1;strokeColor=#222222;fillColor=none;" vertex="1" parent="attendance_3"><mxGeometry x="0" y="49" width="560" height="1" as="geometry"/></mxCell><mxCell id="attendance_6" value="+check_in(user:User, room:Room, evidence:dict, method:CheckInMethod):CheckInResult&lt;br&gt;+check_out(teacher:Teacher, room:Room, evidence:dict):WorkSession&lt;br&gt;+confirm_manually(admin:User, user:User, session:ScheduledSession, reason:string):CheckInResult&lt;br&gt;+close_stale_sessions():int&lt;br&gt;+correct_work_session(admin:User, work:WorkSession, check_out_at:datetime, reason:string):WorkSession&lt;br&gt;-session_for_scan(user:User, room:Room, now:datetime):ScheduledSession&lt;br&gt;-record(user:User, session:ScheduledSession, at:datetime, method:CheckInMethod):CheckInResult" style="fontFamily=Helvetica;html=1;text;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="attendance_3"><mxGeometry x="0" y="49" width="560" height="113" as="geometry"/></mxCell><mxCell id="attendance_7" value="&lt;span style='font-weight:normal'&gt;«i