x="820" y="226" width="102" height="22" as="geometry"/></mxCell></UserObject><mxCell id="teacher_35" value="" style="sketch=1;curveFitting=1;jiggle=2;endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="216" y="252" as="sourcePoint"/><mxPoint x="926" y="252" as="targetPoint"/></mxGeometry></mxCell><UserObject label="Open register" link="data:page/id,register" id="teacher_36"><mxCell style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#dae8fc;strokeColor=#3b6fb6;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1c3f73;" vertex="1" parent="1"><mxGeometry x="820" y="256" width="102" height="22" as="geometry"/></mxCell></UserObject><mxCell id="teacher_37" value="Scan the room code when you arrive and when you leave.&lt;br&gt;The register fills in from student scans." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="216" y="302" width="700" height="40" as="geometry"/></mxCell><mxCell id="teacher_38" value="&lt;b&gt;Replaces the Excel log&lt;/b&gt; (Q1, observation 2): arrival, departure and overtime now come from two scans." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="250" height="76" as="geometry"/></mxCell><mxCell id="teacher_39" value="&lt;b&gt;One row per session&lt;/b&gt; with both states a teacher must close: own attendance and the register." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize