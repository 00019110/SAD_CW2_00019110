0" height="20" as="geometry"/></mxCell><mxCell id="scan_23" value="old photos of the code do not work" style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="392" width="220" height="30" as="geometry"/></mxCell><mxCell id="scan_24" value="&lt;b&gt;QR instead of Face ID&lt;/b&gt;: the CEO named it the affordable option (Q7). Two taps, under 10 seconds (NFR-03.1)." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="250" height="78" as="geometry"/></mxCell><mxCell id="scan_25" value="&lt;b&gt;Rotating code&lt;/b&gt; stops a student sending a photo of the code to a friend (FR-01.1)." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="250" height="62" as="geometry"/></mxCell><mxCell id="scan_26" value="Same screen for teacher and student. A teacher scan opens a work session; a student scan pre-fills the register." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="224" width="250" height="76" as="geometry"/></mxCell><mxCell id="scan_27" value="Flow: accepted → Screen 4. Rejected → Screen 5." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=le