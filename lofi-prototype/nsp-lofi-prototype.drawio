eSpace=wrap;rounded=0;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="576" y="292" width="340" height="150" as="geometry"/></mxCell><mxCell id="student_32" value="Teachers only ever see the average, never who said what." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="216" y="452" width="700" height="24" as="geometry"/></mxCell><mxCell id="student_33" value="&lt;b&gt;Students get two functions only&lt;/b&gt;: scan in, and rate their teachers (Table 3.1 in CW1)." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="250" height="62" as="geometry"/></mxCell><mxCell id="student_34" value="&lt;b&gt;Feedback feeds two things&lt;/b&gt;: 20% of the teacher's KPI, and the student's own dropout risk when most ratings are 1–2 (Q8, Q9)." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="134" width="250" height="82" as="geometry"/></mxCell><mxCell id="student_35" value="&lt;b&gt;Anonymous to teachers&lt;/b&gt; so students answer honestly (FR-04.4)." style="fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#4d3b00;" vertex="1" parent="1"><mxGeometry x="960" y="228" width="250" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>